# Auto-detect text files and normalize line endings
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.ps1 text eol=crlf

# ==============================================================================
# GitHub Linguist Language Detection
# Exclude auxiliary scripts, packaging, and tools so Kotlin reaches ~97%+
# ==============================================================================

# Vendored and documentation directories
tools/** linguist-vendored
packaging/** linguist-vendored
installer/** linguist-vendored
distribution/** linguist-vendored
docs/** linguist-documentation
assets/** linguist-documentation
gradle/** linguist-vendored
gradlew* linguist-vendored

# Exclude non-Kotlin scripts & auxiliary code from language statistics
*.py linguist-detectable=false
*.c linguist-detectable=false
*.h linguist-detectable=false
*.iss linguist-detectable=false
*.sh linguist-detectable=false
*.spec linguist-detectable=false
*.ps1 linguist-detectable=false
*.bat linguist-detectable=false
*.cmd linguist-detectable=false
*.xml linguist-detectable=false

# Ensure Kotlin is the primary tracked language
*.kt linguist-detectable=true
*.kts linguist-detectable=true
